<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <link rel="favicon" href="data:;base64,iVBORw0KGgo=">
  <title>HPlayer: <%= title %></title>

  <!-- HPlayer css -->
  <link rel="stylesheet" href="css/index.css">
  <!-- Font awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.2/css/all.min.css" />

  <!-- Documentation for demo css and javascript -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/asciidoctor.js/1.5.5-5/asciidoctor.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/asciidoctor/asciidoctor@2.0/data/stylesheets/asciidoctor-default.css">

  <link rel="stylesheet" href="https://highlightjs.org/static/demo/styles/base16/outrun-dark.css">
  <script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.2.0/highlight.min.js"></script>
  <link rel="stylesheet" href="css/main.css">
  <link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
  <!-- Bootstrap 5.1.0 CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css">

  <style>
    .fullscreen-container {
      position: relative;
      overflow: hidden;
    }

    .video-container,
    .guide {
      width: 100%;
    }

    .guide {
      height: 100vh;
      overflow-y: scroll;
      padding: 1rem;
      background-color: #f1f1f1;
    }

    .guide p {
      font-size: 1.15rem;
      line-height: 1.6;
    }

    .guide h1,
    .guide h2,
    .guide h3,
    .guide h4 {
      color: #3c763d;
    }

    .guide .highlight .c {
      color: #777;
    }

    .guide .highlight .o {
      color: #666;
    }

    @media (min-width: 992px) {
      .fullscreen-container {
        height: 100vh;
      }

      .video-container {
        height: 95%;
        width: 70%;
        float: left;
      }

      .guide {
        width: 30%;
        height: 100%;
        float: right;
        overflow-y: auto;
      }
    }
  </style>
</head>

<body>
  <script src="https://darshandsoni.com/asciidoctor-skins/switcher.js" type="text/javascript"></script>

  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top animated fadeInDown">
    <a class="navbar-brand" href="./index.html">
      <i class="fas fa-arrow-left"></i>
      HPlayer: <%= title %>
    </a>
  </nav>

  <div class="fullscreen-container">

    <div id="video-container" class="video-container">
      <video autoplay playsinline class="video" style="height: auto; width: 100%; object-fit: cover;"></video>
    </div>

  <div class="guide"></div>

  </div>
      <!-- START DYNAMIC TESTING API BUTTON -->
    <br>
    <h5 class="card-title">Show/Hide controls panel UI</h5>
    <button id="showUi" class="btn btn-primary">Show UI</button>
    <button id="HideUI" class="btn btn-primary">Hide UI</button>
    <br><br>
    <h5 class="card-title">Change video quality</h5>
    <button id="lowestQuality" class="btn btn-primary">Set Lowest Resolution</button>
    <button id="highQuality" class="btn btn-primary">Set Highest Resolution</button>
    <button id="autoQuality" class="btn btn-primary">Set Auto Resolution</button>
    <br><br />
    <h5 class="card-title">Mute/Unmute Volume</h5>
    <button id="mute" class="btn btn-primary">Mute</button>
    <button id="unmute" class="btn btn-primary">Unmute</button>
    <br><br />
    <h5 class="card-title">Insert backward button tooltip text:</h5>
    <input class="input-group-text" name="tooltipText" placeholder="Tooltip Text" type="text">
    <button id="change" class="btn btn-primary">Change</button>
    <!-- END DYNAMIC TESTING API BUTTON -->

  <script>
    const documentation = <%= adoc %>;
    const asciidoctor = Asciidoctor();

    const div = document.querySelector('.guide');
    const html = asciidoctor.convert(documentation, {
      safe: 'safe',
      header_footer: false
    });
    div.insertAdjacentHTML('afterbegin', html);
    hljs.highlightAll();
  </script>

  <script defer src="https://www.gstatic.com/cv/js/sender/v1/cast_sender.js"></script>
  <script defer src="https://github.com/videojs/mux.js/releases/download/v5.13.0/mux.min.js"></script>
  <script type="text/javascript" src="<%= options %>"></script>
  <script type="text/javascript" src="js/HPlayer.bundle.js"></script>

  <script>
    const video = document.querySelector('.video');
    const videoContainer = document.querySelector('#video-container');

    const hplayer = new HPlayer(video, videoContainer, options);
    hplayer.init_();
  </script>
  <!-- START HPlayer PLAYER API javascript -->
  <script>
    const buttons = {
      showButton: document.querySelector('#showUi'),
      hideButton: document.querySelector('#HideUI'),
      setLowQualityButton: document.querySelector('#lowestQuality'),
      setHighQualityButton: document.querySelector('#highQuality'),
      setAutoQualityButton: document.querySelector('#autoQuality'),
      muteButton: document.querySelector('#mute'),
      unmuteButton: document.querySelector('#unmute'),
      updateTooltip: document.querySelector('#change'),
    };

    buttons.showButton.onclick = () => {
      hplayer.showUiControls();
    };

    buttons.hideButton.onclick = () => {
      hplayer.hideUiControls();
    };

    buttons.setLowQualityButton.onclick = () => {
      hplayer.setLowQualityResolution();
    };

    buttons.setHighQualityButton.onclick = () => {
      hplayer.setHighQualityResolution();
    };

    buttons.setAutoQualityButton.onclick = () => {
      hplayer.setAutoQuality();
    };

    buttons.muteButton.onclick = () => {
      hplayer.mute();
    };

    buttons.unmuteButton.onclick = () => {
      hplayer.unmute();
    };

    buttons.updateTooltip.onclick = () => {
      const tooltipText = document.querySelector('input[name="tooltipText"]')
      hplayer.changeButtonTooltipContext('backward-button', tooltipText.value);
    }
  </script>
  <!-- END HPlayer PLAYER API javascript -->

</body>

<script>
  // Disable right-click context menu
  document.addEventListener('contextmenu', function(event) {
    event.preventDefault();
  });
</script>

</html>